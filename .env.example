# Site Shield AI - Environment Configuration Template
# Copy this file to .env and populate values locally.
# NEVER commit .env files, API keys, or confidential configuration to Git.

# Application
APP_NAME=Site Shield AI
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=
API_PORT=
CORS_ORIGINS=

# LLM Configuration (selected in Gate 3)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Embedding Configuration (selected in Gate 3)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Vector Database Configuration (selected in Gate 3)
VECTOR_DB_PROVIDER=
VECTOR_DB_PATH=
VECTOR_DB_URL=
VECTOR_DB_COLLECTION=

# Document Ingestion Guardrails
MAX_UPLOAD_SIZE_MB=
ALLOWED_DOCUMENT_EXTENSIONS=

# Frontend (used once frontend framework is finalized)
API_BASE_URL=

